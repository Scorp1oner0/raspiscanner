[Unit]
Description=RaspiScanner - dashboard scanner di rete e telecamere IP
After=network.target

[Service]
Type=simple
# Serve root (o cap_net_raw/cap_net_admin) per ARP scan e per riconfigurare
# l'interfaccia ethernet (ip addr/link, dhclient).
User=root
WorkingDirectory=/opt/raspiscanner
ExecStart=/opt/raspiscanner/venv/bin/python3 /opt/raspiscanner/raspi-scanner.py
Restart=on-failure
RestartSec=5

# Hardening (P1, conservativo): resta root — la scansione raw-socket e la
# riconfigurazione di rete lo richiedono, una separazione dei privilegi
# richiederebbe una riscrittura architetturale (processo helper separato)
# non verificabile in modo affidabile senza un Raspberry Pi reale — ma si
# tolgono i permessi non necessari a quel compito specifico.
NoNewPrivileges=true
# NON strict: strict rende /etc read-only, e dhclient deve poter scrivere
# /etc/resolv.conf durante l'autoconfigurazione della rete.
ProtectSystem=true
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
